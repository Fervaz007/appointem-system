# --- DEPENDENCIAS ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- BUILD OUTPUTS ---
.next/
out/
build/
dist/
/.vercel

# --- SEGURIDAD (CRÍTICO) ---
# Ignora todos los archivos de entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Solo permite un ejemplo (template) si existiera
!.env.example

# --- TESTING & CALIDAD ---
coverage/
*.lcov
.eslintcache

# --- TYPESCRIPT ---
*.tsbuildinfo
# NOTA: Mantenemos next-env.d.ts FUERA del ignore (quitamos la regla) 
# para consistencia entre devs.

# --- SISTEMA / MISC ---
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*